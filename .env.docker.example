# Configurações Gerais da Aplicação
APP_NAME="Home Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Chave de Criptografia do Laravel (Gere uma com 'php artisan key:generate --show' ou deixe em branco no primeiro boot para gerar automaticamente)
APP_KEY=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Executar migrações automaticamente no boot do container (true / false)
AUTORUN_LARAVEL_MIGRATION=true

# Opção 1: SQLite (Padrão e Recomendado para Homelab simples - persistido no volume Docker)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Opção 2: MySQL / MariaDB (Caso possua um container de banco separado na stack)
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=home_manager
# DB_USERNAME=home_user
# DB_PASSWORD=sua_senha_segura

# Opção 3: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=home_manager
# DB_USERNAME=postgres
# DB_PASSWORD=sua_senha_segura

# Sessão, Cache e Filas (Usando o banco de dados por padrão)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=info
